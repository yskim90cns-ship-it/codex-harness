# Default handoff mode: use the public MyMemory provider from the server route.
# To run an offline UI demo without real translation, uncomment this line:
# TRANSLATION_PROVIDER=mock

# Optional: override the default public MyMemory provider with your own.
# If both are set, the server will POST JSON to TRANSLATION_API_URL with:
# - Authorization: Bearer $TRANSLATION_API_KEY
# - Content-Type: application/json
#
# Expected response shape:
# { "translatedText": "..." }
#
# TRANSLATION_API_URL=https://provider.example/translate
# TRANSLATION_API_KEY=replace-me
